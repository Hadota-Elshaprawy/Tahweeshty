<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحويشتنا - صندوق الادخار المشترك</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (Cairo) -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            900: '#064e3b',
                        },
                        darkBg: '#0f172a',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f8fafc;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .gradient-bg {
            background: linear-gradient(135deg, #064e3b 0%, #047857 50%, #0f172a 100%);
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Notification Toast container -->
    <div id="toast-container" class="fixed top-5 left-5 z-50 flex flex-col gap-2 max-w-sm"></div>

    <!-- MAIN APP CONTAINER -->
    <div id="app" class="flex-grow">
        <!-- JS renders screens here -->
    </div>


    <script>
        // --- DATA STATE AND LOCALSTORAGE LOGIC ---
        const INITIAL_STATE = {
            currentUser: null,
            totalSavings: 0,
            pendingTransactions: [],
            historyTransactions: []
        };

        // BroadcastChannel for instant cross-tab communication
        const syncChannel = window.BroadcastChannel ? new BroadcastChannel('hadota_dodo_sync') : null;

        function getStore() {
            const dataKey = 'hadota_dodo_savings_db';
            const cleanVersionKey = 'hadota_dodo_clean_v1';

            // Clear the old demo transactions once, then preserve new user activity.
            if (!localStorage.getItem(cleanVersionKey)) {
                localStorage.setItem(dataKey, JSON.stringify(INITIAL_STATE));
                localStorage.setItem(cleanVersionKey, '1');
                return INITIAL_STATE;
            }

            const data = localStorage.getItem(dataKey);
            if (!data) {
                localStorage.setItem(dataKey, JSON.stringify(INITIAL_STATE));
                return INITIAL_STATE;
            }
            return JSON.parse(data);
        }

        function saveStore(store, notifyType = null, extraMsg = '') {
            localStorage.setItem('hadota_dodo_savings_db', JSON.stringify(store));
            renderApp();

            // Broadcast change to other open tabs/windows
            if (syncChannel) {
                syncChannel.postMessage({ type: 'DATA_UPDATED', notifyType, extraMsg });
            }
        }

        // Listen to cross-tab updates
        if (syncChannel) {
            syncChannel.onmessage = (event) => {
                if (event.data && event.data.type === 'DATA_UPDATED') {
                    renderApp();
                    if (event.data.notifyType === 'NEW_PENDING') {
                        showToast('💡 معاملة جديدة معلقة من حدوتة تنتظر الموافقة!', 'info');
                    } else if (event.data.notifyType === 'APPROVED') {
                        showToast('🎉 تمت الموافقة على التحويل وإضافته للتحويشة!', 'success');
                    } else if (event.data.notifyType === 'DIRECT_ADD') {
                        showToast('💰 قام دودو بإضافة مبلغ جديد للمجموع الكلي!', 'info');
                    }
                }
            };
        }

        // Fallback for storage event (if BroadcastChannel is not supported)
        window.addEventListener('storage', (e) => {
            if (e.key === 'hadota_dodo_savings_db') {
                renderApp();
            }
        });

        function resetData() {
            if (confirm('هل أنت تأكد من إعادة ضبط كافة البيانات إلى الحالة الافتراضية؟')) {
                localStorage.removeItem('hadota_dodo_savings_db');
                showToast('تمت إعادة ضبط البيانات بنجاح', 'info');
                renderApp();
            }
        }

        // Updated Users Config with requested passwords
        const USERS = {
            hadota: {
                username: 'hadota',
                pass: '1892000',
                name: 'حدوتة (محمود)',
                avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Hadota',
                role: 'عضو مدخر',
                color: 'emerald'
            },
            dodo: {
                username: 'dodo',
                pass: '664822',
                name: 'دودو',
                avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Dodo',
                role: 'مدير الصندوق والاعتمادات',
                color: 'blue'
            }
        };

        // Toast Notification System
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            
            let bg = 'bg-emerald-600';
            let icon = 'fa-circle-check';
            if (type === 'error') { bg = 'bg-rose-600'; icon = 'fa-triangle-exclamation'; }
            if (type === 'info') { bg = 'bg-blue-600'; icon = 'fa-circle-info'; }

            toast.className = `${bg} text-white px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 transition-all duration-300 transform translate-y-2`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-lg"></i><span class="font-semibold text-sm">${message}</span>`;

            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // --- AUTH LOGIC ---
        function handleLogin(e) {
            e.preventDefault();
            const username = e.target.username.value.trim().toLowerCase();
            const password = e.target.password.value.trim();

            if (USERS[username] && USERS[username].pass === password) {
                const store = getStore();
                store.currentUser = username;
                saveStore(store);
                showToast(`مرحباً بك مجدداً يا ${USERS[username].name}!`);
            } else {
                showToast('اسم المستخدم أو كلمة المرور غير صحيحة', 'error');
            }
        }

        function handleLogout() {
            const store = getStore();
            store.currentUser = null;
            saveStore(store);
            showToast('تم تسجيل الخروج بنجاح', 'info');
        }

        // --- TRANSACTION LOGIC ---

        // Hadota sends money -> goes to pending & notifies Dodo instantly
        function submitHadotaMoney(e) {
            e.preventDefault();
            const amount = parseFloat(e.target.amount.value);
            const note = e.target.note.value.trim() || 'تحويل جديد للادخار';

            if (!amount || amount <= 0) {
                showToast('يرجى إدخال مبلغ صحيح', 'error');
                return;
            }

            const store = getStore();
            const newTx = {
                id: 'tx_' + Date.now(),
                sender: 'hadota',
                senderName: USERS.hadota.name,
                amount: amount,
                note: note,
                date: new Date().toLocaleString('ar-EG'),
                status: 'pending'
            };

            store.pendingTransactions.unshift(newTx);
            saveStore(store, 'NEW_PENDING');
            showToast('تم إرسال المبلغ بنجاح! وسيمع فوراً لدى دودو للموافقة عليه.');
        }

        // Dodo sends money -> goes directly to total pool & notifies instantly
        function submitDodoMoney(e) {
            e.preventDefault();
            const amount = parseFloat(e.target.amount.value);
            const note = e.target.note.value.trim() || 'إضافة مباشرة من دودو';

            if (!amount || amount <= 0) {
                showToast('يرجى إدخال مبلغ صحيح', 'error');
                return;
            }

            const store = getStore();
            const newTx = {
                id: 'tx_' + Date.now(),
                sender: 'dodo',
                senderName: USERS.dodo.name,
                amount: amount,
                note: note,
                date: new Date().toLocaleString('ar-EG'),
                status: 'approved'
            };

            store.totalSavings += amount;
            store.historyTransactions.unshift(newTx);
            saveStore(store, 'DIRECT_ADD');
            showToast(`تم إضافة ${amount.toLocaleString('ar-EG')} ج.م مباشرة إلى المجموع الكلي!`);
        }

        // Dodo approves a pending transaction from Hadota
        function approveTransaction(id) {
            const store = getStore();
            const index = store.pendingTransactions.findIndex(t => t.id === id);

            if (index !== -1) {
                const tx = store.pendingTransactions.splice(index, 1)[0];
                tx.status = 'approved';
                tx.approvedDate = new Date().toLocaleString('ar-EG');
                
                store.totalSavings += tx.amount;
                store.historyTransactions.unshift(tx);

                saveStore(store, 'APPROVED');
                showToast(`تمت الموافقة على مبلغ ${tx.amount.toLocaleString('ar-EG')} ج.م وإضافته للمجموع الكلي!`);
            }
        }

        // Dodo rejects a pending transaction
        function rejectTransaction(id) {
            if (!confirm('هل أنت تأكد من رفض هذه المعاملة؟')) return;

            const store = getStore();
            const index = store.pendingTransactions.findIndex(t => t.id === id);

            if (index !== -1) {
                const tx = store.pendingTransactions.splice(index, 1)[0];
                tx.status = 'rejected';
                tx.rejectedDate = new Date().toLocaleString('ar-EG');
                
                store.historyTransactions.unshift(tx);
                saveStore(store, 'REJECTED');
                showToast('تم رفض المعاملة.', 'info');
            }
        }

        // --- RENDER VIEWS ---

        function renderLogin() {
            return `
                <div class="min-h-screen flex items-center justify-center px-4 py-8 relative overflow-hidden"
                     style="background: radial-gradient(circle at 15% 15%, #d1fae5 0, transparent 32%), radial-gradient(circle at 85% 85%, #dbeafe 0, transparent 30%), #f8fafc;">
                    <div class="absolute -top-24 -right-20 w-72 h-72 rounded-full bg-emerald-200/40 blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-24 -left-20 w-72 h-72 rounded-full bg-blue-200/40 blur-3xl pointer-events-none"></div>

                    <div class="relative max-w-md w-full">
                        <div class="bg-white/95 backdrop-blur-xl rounded-[2rem] shadow-2xl shadow-slate-900/10 overflow-hidden border border-white">
                            <div class="gradient-bg px-7 pt-9 pb-8 text-center text-white">
                                <div class="w-16 h-16 bg-white/10 rounded-2xl mx-auto flex items-center justify-center mb-4 border border-white/20 shadow-inner">
                                    <i class="fa-solid fa-arrow-right-arrow-left text-3xl text-emerald-300"></i>
                                </div>
                                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight whitespace-nowrap">تحويل</h1>
                            </div>

                            <form onsubmit="handleLogin(event)" class="p-7 sm:p-8 space-y-5">
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">اسم المستخدم</label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                                            <i class="fa-solid fa-user"></i>
                                        </span>
                                        <input type="text" name="username" required autocomplete="username"
                                               placeholder="اسم المستخدم"
                                               class="w-full pr-11 pl-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">كلمة المرور</label>
                                    <div class="relative">
                                        <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                                            <i class="fa-solid fa-lock"></i>
                                        </span>
                                        <input type="password" name="password" required autocomplete="current-password"
                                               placeholder="••••••••"
                                               class="w-full pr-11 pl-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all">
                                    </div>
                                </div>

                                <button type="submit" class="w-full py-4 px-5 bg-emerald-600 hover:bg-emerald-700 active:scale-[.99] text-white font-extrabold rounded-2xl shadow-lg shadow-emerald-600/25 transition duration-200 flex items-center justify-center gap-3">
                                    <span>دخول</span>
                                    <i class="fa-solid fa-arrow-left"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            `;
        }

        function quickFill(user, pass) {
            document.querySelector('input[name="username"]').value = user;
            document.querySelector('input[name="password"]').value = pass;
        }

        function renderDashboard(store) {
            const user = USERS[store.currentUser];
            const isHadota = store.currentUser === 'hadota';
            const isDodo = store.currentUser === 'dodo';

            // Calculate metrics
            const pendingTotal = store.pendingTransactions.reduce((acc, curr) => acc + curr.amount, 0);

            return `
                <!-- NAVBAR -->
                <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="flex justify-between h-20 items-center">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center font-bold text-xl shadow-lg shadow-emerald-600/20">
                                    <i class="fa-solid fa-vault"></i>
                                </div>
                                <div>
                                    <h1 class="font-extrabold text-xl text-slate-900">تحويشتنا</h1>
                                    <p class="text-xs text-slate-500 font-medium">صندوق الادخار المشترك</p>
                                </div>
                            </div>

                            <!-- USER INFO & LOGOUT -->
                            <div class="flex items-center gap-4">
                                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 p-2 pr-3 rounded-2xl">
                                    <img src="${user.avatar}" alt="${user.name}" class="w-9 h-9 rounded-xl bg-slate-200 border border-white">
                                    <div class="hidden sm:block text-right">
                                        <p class="text-sm font-bold text-slate-800 leading-tight">${user.name}</p>
                                        <span class="inline-block text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">${user.role}</span>
                                    </div>
                                </div>
                                <button onclick="handleLogout()" class="p-2.5 text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition" title="تسجيل الخروج">
                                    <i class="fa-solid fa-right-from-bracket text-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
                    
                    <!-- TOP SUMMARY CARDS -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        
                        <!-- CARD 1: TOTAL SAVINGS -->
                        <div class="gradient-bg rounded-3xl p-6 text-white shadow-xl shadow-emerald-950/10 relative overflow-hidden flex flex-col justify-between">
                            <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
                            <div>
                                <div class="flex justify-between items-center mb-4">
                                    <span class="text-emerald-200 text-sm font-semibold">إجمالي التحويشة المعتمدة</span>
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-emerald-300">
                                        <i class="fa-solid fa-coins text-xl"></i>
                                    </div>
                                </div>
                                <div class="text-4xl font-extrabold tracking-tight mb-2">
                                    ${store.totalSavings.toLocaleString('ar-EG')} <span class="text-lg font-normal text-emerald-200">ج.م</span>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-white/10 flex items-center gap-2 text-xs text-emerald-200">
                                <i class="fa-solid fa-shield-check"></i>
                                <span>المجموع الكلي الجاهز للادخار والموافق عليه</span>
                            </div>
                        </div>

                        <!-- CARD 2: PENDING AMOUNT -->
                        <div class="bg-white rounded-3xl p-6 border border-amber-200/80 shadow-sm relative overflow-hidden flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-center mb-4">
                                    <span class="text-amber-800 text-sm font-bold">المبالغ المعلقة (في انتظار الموافقة)</span>
                                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                        <i class="fa-solid fa-hourglass-half text-xl"></i>
                                    </div>
                                </div>
                                <div class="text-4xl font-extrabold text-slate-800 mb-2">
                                    ${pendingTotal.toLocaleString('ar-EG')} <span class="text-lg font-normal text-slate-500">ج.م</span>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-amber-700">
                                <span class="font-medium">${store.pendingTransactions.length} معاملات قيد الانتظار</span>
                                <i class="fa-solid fa-clock"></i>
                            </div>
                        </div>

                        <!-- CARD 3: ROLE BANNER / ACTION NOTICE -->
                        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="w-3 h-3 rounded-full ${isHadota ? 'bg-emerald-500' : 'bg-blue-500'} animate-ping"></span>
                                    <span class="font-bold text-slate-800">صلاحية الحساب الحالية</span>
                                </div>
                                <p class="text-sm text-slate-600 leading-relaxed">
                                    ${isHadota ? 
                                        'أنت الآن مسجل كـ <strong>حدوتة</strong>. أي مبالغ تقوم بإرسالها ستكون <span class="text-amber-600 font-bold">معلقة</span> حتى يقوم دودو بالموافقة عليها.' : 
                                        'أنت الآن مسجل كـ <strong>دودو</strong>. يمكنك الموافقة/رفض تحويلات حدوتة، أو إضافة مبالغ مباشرة للمجموع الكلي.'
                                    }
                                </p>
                            </div>
                            <div class="mt-4">
                                <button onclick="resetData()" class="text-xs text-slate-400 hover:text-rose-600 underline transition">
                                    <i class="fa-solid fa-rotate-right ml-1"></i> إعادة ضبط البيانات للتجربة
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- ACTION SECTION: DEPOSIT FORM -->
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
                        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                                <i class="fa-solid fa-plus-circle text-xl"></i>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-slate-900">
                                    ${isHadota ? 'إضافة مبلغ جديد للتحويشة (إرسال للموافقة)' : 'إضافة مبلغ مباشر لحساب التحويشة'}
                                </h2>
                                <p class="text-xs text-slate-500">
                                    ${isHadota ? 'سيتم وضع المبلغ في قائمة الانتظار حتى يوافق دودو' : 'سيتم إضافة المبلغ فوراً وإضافته للمجموع الكلي'}
                                </p>
                            </div>
                        </div>

                        <form onsubmit="${isHadota ? 'submitHadotaMoney(event)' : 'submitDodoMoney(event)'}" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-2">المبلغ (بالجنيه)</label>
                                <div class="relative">
                                    <input type="number" min="1" step="any" name="amount" required placeholder="مثال: 1000" 
                                           class="w-full pr-4 pl-12 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs font-bold text-slate-400">ج.م</span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-2">ملاحظة / الوصف (اختياري)</label>
                                <input type="text" name="note" placeholder="مثال: تحويشة الأسبوع، مصاريف..." 
                                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                            </div>

                            <div>
                                <button type="submit" class="w-full py-3 px-6 ${isHadota ? 'bg-amber-600 hover:bg-amber-700' : 'bg-emerald-600 hover:bg-emerald-700'} text-white font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
                                    <i class="fa-solid ${isHadota ? 'fa-paper-plane' : 'fa-check-double'}"></i>
                                    <span>${isHadota ? 'إرسال للموافقة' : 'إضافة مباشرة للمجموع'}</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- PENDING APPROVALS LIST -->
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
                        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                                    <i class="fa-solid fa-clock-rotate-left text-xl"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-900">المعاملات المعلقة (قيد الانتظار)</h2>
                                    <p class="text-xs text-slate-500">المبالغ التي أرسلها حدوتة وتنتظر موافقة دودو</p>
                                </div>
                            </div>
                            <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full">
                                ${store.pendingTransactions.length} معلقة
                            </span>
                        </div>

                        ${store.pendingTransactions.length === 0 ? `
                            <div class="text-center py-10 text-slate-400">
                                <i class="fa-solid fa-circle-check text-4xl mb-3 text-slate-200"></i>
                                <p class="text-sm">لا توجد أي معاملات معلقة حالياً.</p>
                            </div>
                        ` : `
                            <div class="overflow-x-auto">
                                <table class="w-full text-right border-collapse">
                                    <thead>
                                        <tr class="border-b border-slate-100 text-xs font-bold text-slate-400 uppercase">
                                            <th class="pb-3 px-4">المُرسِل</th>
                                            <th class="pb-3 px-4">المبلغ</th>
                                            <th class="pb-3 px-4">الملاحظة</th>
                                            <th class="pb-3 px-4">التاريخ</th>
                                            <th class="pb-3 px-4">الحالة</th>
                                            <th class="pb-3 px-4 text-center">الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-sm">
                                        ${store.pendingTransactions.map(tx => `
                                            <tr class="hover:bg-slate-50/50 transition">
                                                <td class="py-4 px-4 font-bold text-slate-800 flex items-center gap-2">
                                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                                    ${tx.senderName}
                                                </td>
                                                <td class="py-4 px-4 font-extrabold text-slate-900">
                                                    ${tx.amount.toLocaleString('ar-EG')} ج.م
                                                </td>
                                                <td class="py-4 px-4 text-slate-600">${tx.note}</td>
                                                <td class="py-4 px-4 text-xs text-slate-400">${tx.date}</td>
                                                <td class="py-4 px-4">
                                                    <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                                                        <i class="fa-solid fa-spinner animate-spin text-[10px]"></i>
                                                        في انتظار دودو
                                                    </span>
                                                </td>
                                                <td class="py-4 px-4 text-center">
                                                    ${isDodo ? `
                                                        <div class="flex items-center justify-center gap-2">
                                                            <button onclick="approveTransaction('${tx.id}')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow transition flex items-center gap-1">
                                                                <i class="fa-solid fa-check"></i> موافقة
                                                            </button>
                                                            <button onclick="rejectTransaction('${tx.id}')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 hover:text-rose-700 text-xs font-bold px-3 py-1.5 rounded-lg border border-rose-200 transition flex items-center gap-1">
                                                                <i class="fa-solid fa-xmark"></i> رفض
                                                            </button>
                                                        </div>
                                                    ` : `
                                                        <span class="text-xs text-slate-400 italic">بانتظار اعتماد دودو</span>
                                                    `}
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        `}
                    </div>

                    <!-- APPROVED / HISTORY TRANSACTIONS LOG -->
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8">
                        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold">
                                    <i class="fa-solid fa-receipt text-xl"></i>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-900">سجل المعاملات المكتملة والاعتمادات</h2>
                                    <p class="text-xs text-slate-500">سجل كامل بجميع العمليات الناجحة والمضافة للمجموع</p>
                                </div>
                            </div>
                        </div>

                        ${store.historyTransactions.length === 0 ? `
                            <div class="text-center py-10 text-slate-400">
                                <p class="text-sm">لا يوجد سجل معاملات حتى الآن.</p>
                            </div>
                        ` : `
                            <div class="overflow-x-auto">
                                <table class="w-full text-right border-collapse">
                                    <thead>
                                        <tr class="border-b border-slate-100 text-xs font-bold text-slate-400 uppercase">
                                            <th class="pb-3 px-4">المُرسِل</th>
                                            <th class="pb-3 px-4">المبلغ</th>
                                            <th class="pb-3 px-4">الملاحظة</th>
                                            <th class="pb-3 px-4">التاريخ</th>
                                            <th class="pb-3 px-4">الحالة النهائيّة</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-sm">
                                        ${store.historyTransactions.map(tx => {
                                            const isApproved = tx.status === 'approved';
                                            return `
                                                <tr class="hover:bg-slate-50/50 transition">
                                                    <td class="py-4 px-4 font-bold text-slate-800">
                                                        <span class="inline-block w-2 h-2 rounded-full ${tx.sender === 'hadota' ? 'bg-emerald-500' : 'bg-blue-500'} ml-2"></span>
                                                        ${tx.senderName}
                                                    </td>
                                                    <td class="py-4 px-4 font-extrabold ${isApproved ? 'text-emerald-600' : 'text-rose-500'}">
                                                        ${isApproved ? '+' : ''}${tx.amount.toLocaleString('ar-EG')} ج.م
                                                    </td>
                                                    <td class="py-4 px-4 text-slate-600">${tx.note}</td>
                                                    <td class="py-4 px-4 text-xs text-slate-400">${tx.date}</td>
                                                    <td class="py-4 px-4">
                                                        ${isApproved ? `
                                                            <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
                                                                <i class="fa-solid fa-check text-[10px]"></i>
                                                                تم الاعتماد والمباشرة
                                                            </span>
                                                        ` : `
                                                            <span class="inline-flex items-center gap-1 text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-full">
                                                                <i class="fa-solid fa-xmark text-[10px]"></i>
                                                                مرفوض
                                                            </span>
                                                        `}
                                                    </td>
                                                </tr>
                                            `;
                                        }).join('')}
                                    </tbody>
                                </table>
                            </div>
                        `}
                    </div>

                </main>
            `;
        }

        // --- MAIN RENDER CONTROLLER ---
        function renderApp() {
            const store = getStore();
            const app = document.getElementById('app');

            if (!store.currentUser) {
                app.innerHTML = renderLogin();
            } else {
                app.innerHTML = renderDashboard(store);
            }
        }

        // Initialize App
        window.onload = function() {
            renderApp();
        };
    </script>
</body>
</html>
